// Helper: get sprite SVG for a pose, with size override
function getPoseSprite(figureKey, opts = {}) {
  const { width = 200, height = 280 } = opts;
  const base = POSE_SPRITES[figureKey] || POSE_SPRITES['standing-neutral'];
  return base
    .replace(/width="\d+"/, `width="${width}"`)
    .replace(/height="\d+"/, `height="${height}"`);
}

if (typeof module !== "undefined" && module.exports) {
  module.exports = { POSE_SPRITES, getPoseSprite };
}
