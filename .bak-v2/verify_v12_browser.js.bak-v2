const { chromium } = require('playwright');
const fs = require('fs');
const path = require('path');

(async () => {
  const outDir = path.join(process.cwd(), 'audit', 'screenshots', 'v1.2');
  fs.mkdirSync(outDir, { recursive: true });
  const browser = await chromium.launch({ headless: true });
  const context = await browser.newContext({ viewport: { width: 430, height: 932 }, deviceScaleFactor: 2, isMobile: true, hasTouch: true });
  const page = await context.newPage();
  page.setDefaultTimeout(8000);
  const errors = [];
  page.on('console', msg => { if (msg.type() === 'error') errors.push(msg.text()); });
  page.on('pageerror', err => errors.push(err.message));
  await page.goto('http://localhost:8095/index.html', { waitUntil: 'networkidle' });
  await page.evaluate(() => window.completeOnboardingSkip());
  const poses = ['scurve-stand', 'fence-lean', 'upper-reach', 'highlow-full-recline-final-settle', 'editorial-arms-crossed-overhead'];
  const rendered = {};
  for (const poseId of poses) {
    await page.evaluate(id => window.openPoseDetail(id), poseId);
    await page.waitForTimeout(300);
    const canvas = page.locator('[data-testid="canvas-skeleton-3d"]');
    rendered[poseId] = await canvas.evaluate(c => c.getContext('2d').getImageData(0, 0, c.width, c.height).data.some(v => v !== 0));
    await page.screenshot({ path: path.join(outDir, poseId + '.png'), fullPage: false });
  }
  await page.evaluate(() => window.goToSession('scurve-stand'));
  await page.evaluate(() => window.updateSessionSetupOverlayPreview('ghost'));
  await page.waitForTimeout(250);
  const ghost = await page.locator('#setup-ghost-canvas').evaluate(c => c.getContext('2d').getImageData(0, 0, c.width, c.height).data.some(v => v !== 0));
  await page.screenshot({ path: path.join(outDir, 'scurve-ghost-water.png'), fullPage: false });
  console.log(JSON.stringify({ rendered, ghost, errors }, null, 2));
  if (Object.values(rendered).some(v => !v) || !ghost || errors.length) process.exitCode = 1;
  await browser.close();
})().catch(err => { console.error(err); process.exit(1); });

