# .env.example — Variables de entorno para PoseArt backend
#
# COPIA este archivo a .env y reemplaza los valores entre <...>
# NUNCA commits el archivo .env real con secretos.
# El archivo .gitignore debe incluir: .env
#
# ════════════════════════════════════════════════════════════
# CLAVES PÚBLICAS (seguras para el navegador)
# ════════════════════════════════════════════════════════════

# Supabase — Project URL y anon key (públicas, seguras en frontend)
# Obtén estos valores en: Supabase Dashboard → Settings → API
SUPABASE_URL=https://<tu-proyecto-ref>.supabase.co
SUPABASE_ANON_KEY=<tu-anon-key-publica>

# Stripe — Publishable key (público, seguro en frontend)
# Obtén este valor en: Stripe Dashboard → Developers → API Keys
STRIPE_PUBLISHABLE_KEY=pk_test_<tu-publishable-key-de-test>

# PostHog — Project key (público, seguro en frontend)
# Obtén este valor en: PostHog → Project Settings
POSTHOG_KEY=<tu-posthog-project-key>
POSTHOG_HOST=https://<tu-posthog-host>.posthog.com

# Sentry — DSN (público, seguro en frontend)
# Obtén este valor en: Sentry → Project Settings → Client Keys
SENTRY_DSN=https://<tu-sentry-dsn>@sentry.io/<tu-project-id>

# ════════════════════════════════════════════════════════════
# CLAVES SECRETAS (SOLO servidor — Edge Functions)
# NUNCA pongas estas claves en HTML, JS del navegador, o Git
# ════════════════════════════════════════════════════════════

# Supabase — Service Role key (SECRETO — bypasses RLS)
# Úsala SOLO en Edge Functions y scripts de servidor
# NUNCA la expongas al navegador
SUPABASE_SERVICE_ROLE_KEY=<tu-service-role-key-secreta>

# Stripe — Secret key (SECRETO)
# Úsala SOLO en Edge Functions para crear Checkout Sessions
# NUNCA la expongas al navegador
STRIPE_SECRET_KEY=sk_test_<tu-secret-key-de-test>

# Stripe — Webhook signing secret (SECRETO)
# Úsalo para verificar la firma de los webhooks entrantes
# Obtén este valor al registrar tu endpoint en: Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_<tu-webhook-signing-secret>

# ════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE LA APP
# ════════════════════════════════════════════════════════════

# URL base de tu aplicación (para redirecciones de auth y Stripe)
# En desarrollo local: http://localhost:8095
# En producción: https://tu-dominio.com
APP_URL=http://localhost:8095

# Entorno: development | staging | production
NODE_ENV=development

# ════════════════════════════════════════════════════════════
# CHECKLIST DE SEGURIDAD
# ════════════════════════════════════════════════════════════
#
# [ ] .env está en .gitignore
# [ ] SUPABASE_SERVICE_ROLE_KEY no aparece en ningún archivo JS del navegador
# [ ] STRIPE_SECRET_KEY no aparece en ningún archivo JS del navegador
# [ ] STRIPE_WEBHOOK_SECRET no aparece en ningún archivo JS del navegador
# [ ] .env.example no contiene secretos reales (solo placeholders)
# [ ] Los secretos de producción están en variables de entorno del hosting
#     (GitHub Secrets, Vercel env vars, etc.) — no en archivos
